bool lib7D432011_gt_AlliedAIDeselected_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventUnit() == lib7D432011_gv_aIController))) {
            return false;
        }

        if (!((lib7D432011_gv_alliedUIActive == true))) {
