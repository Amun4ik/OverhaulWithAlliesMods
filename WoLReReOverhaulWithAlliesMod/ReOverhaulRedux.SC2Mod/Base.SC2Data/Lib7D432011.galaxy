    libNtve_gf_CreateDialogItemButton(lib7D432011_gv_aIControllerDialog, 80, 89, c_anchorCenter, 0, 0, StringExternal("Param/Value/lib_7D432011_40CFB344"), StringToText(""), "Assets\\Textures\\ui_hots_button_shared_hero_hover.dds");
    lib7D432011_gv_aIControllerButton = DialogControlLastCreated();
    libNtve_gf_SetDialogItemImage(DialogControlLastCreated(), "Assets\\Textures\\ui_hots_button_shared_hero_normal.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImageType(DialogControlLastCreated(), c_triggerImageTypeNormal, PlayerGroupAll());
    libNtve_gf_SetDialogItemBackgroundVisible(DialogControlLastCreated(), false, PlayerGroupAll());
    libNtve_gf_SetDialogItemHotkey(DialogControlLastCreated(), c_hotkeyHeroSelect2, PlayerGroupAll());
    DialogSetVisible(lib7D432011_gv_aIControllerDialog, PlayerGroupAll(), true);
    DialogControlSetVisible(lib7D432011_gv_aIControllerButton, PlayerGroupAll(), true);
    TriggerEnable(lib7D432011_gt_AlliedAIClicked, true);
    TriggerEnable(lib7D432011_gt_AlliedAIHotkey, true);
    TriggerEnable(lib7D432011_gt_AlliedAIDeselectedHotkey, true);
    TriggerEnable(lib7D432011_gt_AlliedAIDeselected, true);
    while (true) {
        if ((libNtve_gf_PlayerInCinematicMode(1) == true)) {
            DialogSetVisible(lib7D432011_gv_aIControllerDialog, PlayerGroupAll(), false);
        }
        else {
            DialogSetVisible(lib7D432011_gv_aIControllerDialog, PlayerGroupAll(), true);
        }
        Wait(0.1, c_timeGame);
    }
    return true;
}

