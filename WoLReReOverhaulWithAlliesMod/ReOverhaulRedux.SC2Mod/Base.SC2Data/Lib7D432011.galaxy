// Trigger: Allied AI Clicked
//--------------------------------------------------------------------------------------------------
bool lib7D432011_gt_AlliedAIClicked_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == lib7D432011_gv_aIControllerButton))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_StoreUnitSelection(1, libNtve_ge_UnitSelectionStoreOption_ClearUnitSelection);
    UnitGroupSelect(UnitGroupSelected(1), 1, false);
    SoundPlayForPlayer(SoundLink("UI_PushButtonSelect", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    UnitSelect(lib7D432011_gv_aIController, 1, true);
    lib7D432011_gv_alliedUIActive = true;
    return true;
}

