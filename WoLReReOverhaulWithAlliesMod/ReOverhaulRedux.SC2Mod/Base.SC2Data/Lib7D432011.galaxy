// Presets
// Functions
void lib7D432011_gf_RescueUnitforAI (unit lp_cHOSEN_UNIT, point lp_tARGET_POINT, int lp_cHOSEN_PLAYER, bool lp_iMMIDIATE_ATTACK) {
    // Automatic Variable Declarations
    // Implementation
    libNtve_gf_PauseUnit(lp_cHOSEN_UNIT, false);
    libNtve_gf_MakeUnitInvulnerable(lp_cHOSEN_UNIT, false);
    libNtve_gf_RescueUnit(lp_cHOSEN_UNIT, lp_cHOSEN_PLAYER, true);
    AISetUnitScriptControlled(lp_cHOSEN_UNIT, false);
    if ((lp_tARGET_POINT != null)) {
        libNtve_gf_AICast(lp_cHOSEN_UNIT, OrderTargetingPoint(AbilityCommand("attack", 0), lp_tARGET_POINT));
    }

    UnitSetInfoTip(lp_cHOSEN_UNIT, UnitTypeGetName(UnitGetType(lp_cHOSEN_UNIT)));
    if ((lp_iMMIDIATE_ATTACK == true) && (UnitGetType(lp_cHOSEN_UNIT) != "Drone")) {
        AISetUnitSuicide(lp_cHOSEN_UNIT, true);
    }

    if ((lp_iMMIDIATE_ATTACK == false) && (UnitGetType(lp_cHOSEN_UNIT) != "Drone")) {
        AIAttackWaveUseUnit(lp_cHOSEN_PLAYER, lp_cHOSEN_UNIT);
    }

}

