//--------------------------------------------------------------------------------------------------
bool lib7D432011_gt_AlliedAIDeselectedHotkey_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((lib7D432011_gv_alliedUIActive == true))) {
            return false;
        }

        if (!((UnitAbilityCheck(lib7D432011_gv_aIController, "AlliedAICancelBeacon", true) == false))) {
