//--------------------------------------------------------------------------------------------------
// Trigger: AIResourcePanelUpdater
//--------------------------------------------------------------------------------------------------
bool libD8BB74C6_gt_AIResourcePanelUpdater_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;
    text lv_supplyLabelColor;

    // Automatic Variable Declarations
    const int autoB1BD5D2D_ae = 16;
    const int autoB1BD5D2D_ai = 1;

    // Variable Initialization
    lv_supplyLabelColor = StringToText("");

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    while (true) {
        lv_player = 1;
        for ( ; ( (autoB1BD5D2D_ai >= 0 && lv_player <= autoB1BD5D2D_ae) || (autoB1BD5D2D_ai < 0 && lv_player >= autoB1BD5D2D_ae) ) ; lv_player += autoB1BD5D2D_ai ) {
            if ((libD8BB74C6_gv_aIResourcePanelDialog[lv_player] != c_invalidDialogId)) {
                libNtve_gf_SetDialogItemText(libD8BB74C6_gv_aIResourcePanelMineralsLabel[lv_player], IntToText(PlayerGetPropertyInt(lv_player, c_playerPropMinerals)), PlayerGroupAll());
                libNtve_gf_SetDialogItemText(libD8BB74C6_gv_aIResourcePanelVespeneLabel[lv_player], IntToText(PlayerGetPropertyInt(lv_player, c_playerPropVespene)), PlayerGroupAll());
                if ((PlayerGetPropertyFixed(lv_player, c_playerPropSuppliesUsed) > PlayerGetPropertyFixed(lv_player, c_playerPropSuppliesMade))) {
                    lv_supplyLabelColor = StringExternal("Param/Value/lib_D8BB74C6_5D7BE01E");
                }
                else {
                    lv_supplyLabelColor = StringToText("");
                }
                if ((PlayerGetPropertyFixed(lv_player, c_playerPropSuppliesMade) > PlayerGetPropertyFixed(lv_player, c_playerPropSuppliesLimit))) {
                    TextExpressionSetToken("Param/Expression/lib_D8BB74C6_33BDB053", "C", lv_supplyLabelColor);
                    TextExpressionSetToken("Param/Expression/lib_D8BB74C6_33BDB053", "A", IntToText(PlayerGetPropertyInt(lv_player, c_playerPropSuppliesUsed)));
                    TextExpressionSetToken("Param/Expression/lib_D8BB74C6_33BDB053", "B", IntToText(PlayerGetPropertyInt(lv_player, c_playerPropSuppliesLimit)));
                    libNtve_gf_SetDialogItemText(libD8BB74C6_gv_aIResourcePanelSupplyLabel[lv_player], TextExpressionAssemble("Param/Expression/lib_D8BB74C6_33BDB053"), PlayerGroupAll());
                }
                else {
                    TextExpressionSetToken("Param/Expression/lib_D8BB74C6_50E8AE0A", "C", lv_supplyLabelColor);
                    TextExpressionSetToken("Param/Expression/lib_D8BB74C6_50E8AE0A", "A", IntToText(PlayerGetPropertyInt(lv_player, c_playerPropSuppliesUsed)));
                    TextExpressionSetToken("Param/Expression/lib_D8BB74C6_50E8AE0A", "B", IntToText(PlayerGetPropertyInt(lv_player, c_playerPropSuppliesMade)));
                    libNtve_gf_SetDialogItemText(libD8BB74C6_gv_aIResourcePanelSupplyLabel[lv_player], TextExpressionAssemble("Param/Expression/lib_D8BB74C6_50E8AE0A"), PlayerGroupAll());
                }
            }

        }
        Wait(0.0625, c_timeAI);
    }
    return true;
}

