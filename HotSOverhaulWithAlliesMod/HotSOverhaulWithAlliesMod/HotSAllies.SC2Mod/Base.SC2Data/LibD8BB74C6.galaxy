//--------------------------------------------------------------------------------------------------
// Trigger: Allied AI Deselected
//--------------------------------------------------------------------------------------------------
bool libD8BB74C6_gt_AlliedAIDeselected_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventUnit() == libD8BB74C6_gv_aIController))) {
            return false;
        }

        if (!((libD8BB74C6_gv_alliedUIActive == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libD8BB74C6_gv_alliedUIActive = false;
    return true;
}

//--------------------------------------------------------------------------------------------------
void libD8BB74C6_gt_AlliedAIDeselected_Init () {
    libD8BB74C6_gt_AlliedAIDeselected = TriggerCreate("libD8BB74C6_gt_AlliedAIDeselected_Func");
    TriggerEnable(libD8BB74C6_gt_AlliedAIDeselected, false);
    TriggerAddEventUnitSelected(libD8BB74C6_gt_AlliedAIDeselected, null, c_playerAny, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Allied AI Deselected Hotkey
//--------------------------------------------------------------------------------------------------
bool libD8BB74C6_gt_AlliedAIDeselectedHotkey_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libD8BB74C6_gv_alliedUIActive == true))) {
            return false;
        }

        if (!((UnitAbilityCheck(libD8BB74C6_gv_aIController, "AlliedAICancelBeacon", true) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libD8BB74C6_gv_alliedUIActive = false;
    UnitSelect(libD8BB74C6_gv_aIController, 1, false);
    libNtve_gf_RestoreUnitSelection(1);
    return true;
}

