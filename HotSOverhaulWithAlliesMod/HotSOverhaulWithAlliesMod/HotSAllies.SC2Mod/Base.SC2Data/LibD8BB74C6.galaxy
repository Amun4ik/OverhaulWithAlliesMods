// Trigger: Init Allied AI UI
//--------------------------------------------------------------------------------------------------
bool libD8BB74C6_gt_InitAlliedAIUI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    DialogCreate(80, 80, c_anchorBottomRight, 5, 350, true);
    libD8BB74C6_gv_aIControllerDialog = DialogLastCreated();
    libNtve_gf_CreateDialogItemButton(libD8BB74C6_gv_aIControllerDialog, 76, 76, c_anchorCenter, 0, 0, StringExternal("Param/Value/lib_D8BB74C6_AFE8DA5C"), StringToText(""), "Assets\\Textures\\ui_hots_button_shared_hero_hover.dds");
    libD8BB74C6_gv_aIControllerButton = DialogControlLastCreated();
    libNtve_gf_SetDialogItemImage(DialogControlLastCreated(), "Assets\\Textures\\ui_hots_button_shared_hero_normal.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImageType(DialogControlLastCreated(), c_triggerImageTypeNormal, PlayerGroupAll());
    libNtve_gf_SetDialogItemBackgroundVisible(DialogControlLastCreated(), false, PlayerGroupAll());
    libNtve_gf_SetDialogItemHotkey(DialogControlLastCreated(), c_hotkeyHeroSelect2, PlayerGroupAll());
    libNtve_gf_CreateDialogItemImage(DialogLastCreated(), 60, 60, c_anchorCenter, 0, 0, StringToText(""), "Assets\\Textures\\ui_battlenet_glues_scorescreen_raceicon_zerg.dds", c_triggerImageTypeNormal, true, Color(84*100/255,0,129*100/255), c_triggerBlendModeNormal);
    DialogSetVisible(libD8BB74C6_gv_aIControllerDialog, PlayerGroupAll(), true);
    DialogControlSetVisible(libD8BB74C6_gv_aIControllerButton, PlayerGroupAll(), true);
    TriggerEnable(libD8BB74C6_gt_AlliedAIClicked, true);
    TriggerEnable(libD8BB74C6_gt_AlliedAIHotkey, true);
    TriggerEnable(libD8BB74C6_gt_AlliedAIDeselectedHotkey, true);
    TriggerEnable(libD8BB74C6_gt_AlliedAIDeselected, true);
    while (true) {
        if ((libNtve_gf_PlayerInCinematicMode(1) == true)) {
            DialogSetVisible(libD8BB74C6_gv_aIControllerDialog, PlayerGroupAll(), false);
        }
        else {
            DialogSetVisible(libD8BB74C6_gv_aIControllerDialog, PlayerGroupAll(), true);
        }
        Wait(0.1, c_timeGame);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libD8BB74C6_gt_InitAlliedAIUI_Init () {
    libD8BB74C6_gt_InitAlliedAIUI = TriggerCreate("libD8BB74C6_gt_InitAlliedAIUI_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Allied AI Clicked
//--------------------------------------------------------------------------------------------------
bool libD8BB74C6_gt_AlliedAIClicked_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == libD8BB74C6_gv_aIControllerButton))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_StoreUnitSelection(1, libNtve_ge_UnitSelectionStoreOption_ClearUnitSelection);
    UnitGroupSelect(UnitGroupSelected(1), 1, false);
    SoundPlayForPlayer(SoundLink("UI_PushButtonSelect", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    UnitSelect(libD8BB74C6_gv_aIController, 1, true);
    libD8BB74C6_gv_alliedUIActive = true;
    return true;
}

//--------------------------------------------------------------------------------------------------
void libD8BB74C6_gt_AlliedAIClicked_Init () {
    libD8BB74C6_gt_AlliedAIClicked = TriggerCreate("libD8BB74C6_gt_AlliedAIClicked_Func");
    TriggerEnable(libD8BB74C6_gt_AlliedAIClicked, false);
    TriggerAddEventDialogControl(libD8BB74C6_gt_AlliedAIClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Allied AI Hotkey
//--------------------------------------------------------------------------------------------------
bool libD8BB74C6_gt_AlliedAIHotkey_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libNtve_gf_PlayerInCinematicMode(1) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_StoreUnitSelection(1, libNtve_ge_UnitSelectionStoreOption_ClearUnitSelection);
    UnitGroupSelect(UnitGroupSelected(1), 1, false);
    SoundPlayForPlayer(SoundLink("UI_PushButtonSelect", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    UnitSelect(libD8BB74C6_gv_aIController, 1, true);
    libD8BB74C6_gv_alliedUIActive = true;
    return true;
}

