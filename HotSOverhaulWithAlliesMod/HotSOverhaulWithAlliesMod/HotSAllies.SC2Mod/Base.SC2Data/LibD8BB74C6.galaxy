// Trigger: Naktul Fortify
//--------------------------------------------------------------------------------------------------
bool libD8BB74C6_gt_NaktulFortify_Func (bool testConds, bool runActions) {
    // Variable Declarations
    region lv_bullyArea;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    SoundPlayForPlayer(SoundLink("zMission_Lab03_BroodMother01_020", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    lv_bullyArea = RegionCircle(EventUnitTargetPoint(), 4.0);
    AIAddBully(libD8BB74C6_gv_naktulAlly, "SpineCrawler", RegionRandomPoint(lv_bullyArea), 1);
    AIAddBully(libD8BB74C6_gv_naktulAlly, "Zergling", RegionRandomPoint(lv_bullyArea), 1);
    AIAddBully(libD8BB74C6_gv_naktulAlly, "Zergling", RegionRandomPoint(lv_bullyArea), 1);
    AIAddBully(libD8BB74C6_gv_naktulAlly, "Zergling", RegionRandomPoint(lv_bullyArea), 1);
    AIAddBully(libD8BB74C6_gv_naktulAlly, "Zergling", RegionRandomPoint(lv_bullyArea), 1);
    AIAddBully(libD8BB74C6_gv_naktulAlly, "Hydralisk", RegionRandomPoint(lv_bullyArea), 1);
    AIAddBully(libD8BB74C6_gv_naktulAlly, "Roach", RegionRandomPoint(lv_bullyArea), 1);
    libNtve_gf_CreateModelAtPoint("BeaconDefend", EventUnitTargetPoint());
    Wait(60.0, c_timeGame);
    libNtve_gf_KillModel(libNtve_gf_ActorLastCreated());
    return true;
}

